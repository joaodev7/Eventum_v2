# ==============================================================================
# EVENTUM BACKEND (.NET 8) — CONFIGURAÇÕES DE PRODUÇÃO (RENDER / DOCKER / NEONDB)
# ==============================================================================
# No painel do Render (Web Service > Environment), cadastre as variáveis abaixo:

# 1. Ambiente de Execução
ASPNETCORE_ENVIRONMENT=Production

# 2. Conexão com NeonDB (PostgreSQL Serverless)
# Substitua com os dados do seu endpoint Neon (ex: ep-xyz-123.us-east-2.aws.neon.tech)
# NOTA: O Npgsql requer SSL Mode=Require e Trust Server Certificate=true para NeonDB
ConnectionStrings__DefaultConnection="Host=ep-xyz.us-east-2.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=SUA_SENHA_AQUI;SSL Mode=Require;Trust Server Certificate=true"

# 3. Autenticação JWT
# A chave secreta deve ter NO MÍNIMO 32 caracteres (256 bits) para HMAC-SHA256
Jwt__Secret="EventumSuperSecretProductionKey2026Min32CharsRequirementForSha256Security!"
Jwt__Issuer="EventumApi"
Jwt__Audience="EventumClient"
Jwt__ExpiryMinutes=120
Jwt__RefreshTokenExpiryDays=30

# 4. Envio Transacional de E-mails (Resend) - Opcional no início
Resend__ApiKey="re_sua_chave_do_resend_aqui"
Resend__FromEmail="Eventum <contato@seudominio.com.br>"

# 5. Armazenamento de Arquivos
Storage__Provider="local"
Storage__LocalPath="wwwroot/uploads"

# 6. Gateway de Pagamento Stripe (Opcional no início)
Stripe__SecretKey="sk_test_..."
Stripe__PublishableKey="pk_test_..."
Stripe__WebhookSecret="whsec_..."

# 7. Gateway de Pagamento Mercado Pago (Opcional no início)
MercadoPago__AppId="seu_app_id"
MercadoPago__ClientSecret="seu_client_secret"
MercadoPago__WebhookSecret="seu_webhook_secret"
